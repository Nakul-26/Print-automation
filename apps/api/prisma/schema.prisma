// Phase 0 schema: only the platform-level settings table.
// Identity, shops, orders, etc. arrive in later phases as separate reviewed migrations.
// The database URL lives in prisma.config.ts (Prisma 7) and is passed to the client via an adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Runtime-adjustable platform settings (storage limits, retention, ...).
/// Values are JSON so a setting can be a number, a string, or a small object.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

enum PlatformRole {
  user
  platform_admin
}

enum ShopStatus {
  pending_approval
  active
  suspended
}

enum ShopRole {
  owner
  staff
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  platformRole PlatformRole @default(user) @map("platform_role")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions    Session[]
  memberships ShopMember[]

  @@map("users")
}

/// Server-side login sessions. Only an HMAC of the cookie token is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Shop {
  id                String     @id @default(uuid()) @db.Uuid
  slug              String     @unique
  name              String
  status            ShopStatus @default(pending_approval)
  address           String?
  contactPhone      String?    @map("contact_phone")
  timezone          String     @default("Asia/Kolkata")
  currency          String     @default("INR")
  /// Per-shop settings and feature flags (retention hours, enabled formats, ...).
  settings          Json       @default("{}")
  /// Null means "use the platform default".
  storageQuotaBytes BigInt?    @map("storage_quota_bytes")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  members       ShopMember[]
  uploads       Upload[]
  rates         ShopRate[]
  pricing       ShopPricing?
  orders        Order[]
  printerAgents AgentDevice[]
  agentPairings AgentPairing[]
  shopPrinters  ShopPrinter[]
  printJobs     PrintJob[]

  @@map("shops")
}

model ShopMember {
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ShopRole
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id")
  shopId    String?  @map("shop_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

enum UploadStatus {
  processing
  ready
  failed
}

/// A document a student uploaded to a shop, before it becomes part of an order.
/// The unguessable access token is only ever stored as an HMAC.
model Upload {
  id                  String       @id @default(uuid()) @db.Uuid
  shopId              String       @map("shop_id") @db.Uuid
  tokenHash           String       @unique @map("token_hash")
  originalName        String       @map("original_name")
  detectedMime        String       @map("detected_mime")
  sizeBytes           Int          @map("size_bytes")
  contentSha256       String       @map("content_sha256")
  status              UploadStatus @default(processing)
  errorCode           String?      @map("error_code")
  errorMessage        String?      @map("error_message")
  pageCount           Int?         @map("page_count")
  originalKey         String?      @map("original_key")
  normalizedKey       String?      @map("normalized_key")
  normalizedSizeBytes Int?         @map("normalized_size_bytes")
  /// pdf | image | office, decided from the file's bytes.
  documentKind        String       @default("pdf") @map("document_kind")
  /// writer | calc | impress for Office documents.
  officeFamily        String?      @map("office_family")
  /// How an Office document is converted (paper size, orientation, ...): the current settings.
  conversionSettings  Json?        @map("conversion_settings")
  /// Bumped whenever the settings change so that stale conversion jobs can be ignored.
  conversionRevision  Int          @default(0) @map("conversion_revision")
  /// Every converted variant kept for this upload: { <settingsHash>: { key, size, pages, settings } }.
  conversionVariants  Json?        @map("conversion_variants")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  /// Files are deleted after this time (24 h from creation by default).
  expiresAt           DateTime     @map("expires_at")
  filesPurgedAt       DateTime?    @map("files_purged_at")

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItem OrderItem?

  @@index([shopId, createdAt])
  @@index([expiresAt])
  @@map("uploads")
}

/// One price: what a shop charges per printed side for a paper size / colour / sides combination.
model ShopRate {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @map("shop_id") @db.Uuid
  paperSize         String   @map("paper_size")
  colorMode         String   @map("color_mode")
  sides             String
  /// Integer paise (1/100 rupee) so money is never fractional.
  pricePerSidePaise Int      @map("price_per_side_paise")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, paperSize, colorMode, sides])
  @@map("shop_rates")
}

model ShopPricing {
  shopId             String   @id @map("shop_id") @db.Uuid
  minimumChargePaise Int      @default(0) @map("minimum_charge_paise")
  updatedAt          DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_pricing")
}

enum OrderStatus {
  processing
  pending
  accepted
  printing
  completed
  rejected
  failed
  expired
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  shopId               String      @map("shop_id") @db.Uuid
  /// Queue date in the shop's timezone (YYYY-MM-DD) and the number within that day: "P014".
  queueDate            String      @map("queue_date")
  queueNumber          Int         @map("queue_number")
  /// Unguessable handle the student uses to follow the order; only its HMAC is stored.
  lookupTokenHash      String      @unique @map("lookup_token_hash")
  customerName         String?     @map("customer_name")
  status               OrderStatus @default(processing)
  estimatedAmountPaise Int         @map("estimated_amount_paise")
  finalAmountPaise     Int?        @map("final_amount_paise")
  currency             String      @default("INR")
  /// The rates and minimum charge in force when the order was placed.
  rateSnapshot         Json        @map("rate_snapshot")
  rejectionReason      String?     @map("rejection_reason")
  failureReason        String?     @map("failure_reason")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  completedAt          DateTime?   @map("completed_at")
  /// Files are deleted after this time (24 h from order creation).
  expiresAt            DateTime    @map("expires_at")
  filesPurgedAt        DateTime?   @map("files_purged_at")

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([shopId, queueDate, queueNumber])
  @@index([shopId, status, createdAt])
  @@index([expiresAt])
  @@map("orders")
}

/// One document in an order, with its own print settings.
model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  /// Denormalised so every query on this table can be scoped by shop.
  shopId            String  @map("shop_id") @db.Uuid
  /// An upload can belong to at most one order item.
  uploadId          String  @unique @map("upload_id") @db.Uuid
  position          Int
  originalName      String  @map("original_name")
  pageCount         Int     @map("page_count")
  printSettings     Json    @map("print_settings")
  /// 1-based pages chosen from the document, in print order.
  selectedPages     Json    @map("selected_pages")
  selectedPageCount Int     @map("selected_page_count")
  printedSides      Int     @map("printed_sides")
  sheets            Int
  amountPaise       Int     @map("amount_paise")
  /// The converted PDF this item was ordered from (snapshot of the chosen conversion variant).
  sourceKey         String  @map("source_key")
  /// The exact PDF to print (page range, N-up, grayscale applied). Filled by the prepare job.
  printPdfKey       String? @map("print_pdf_key")
  printPdfBytes     Int?    @map("print_pdf_bytes")
  printPdfPages     Int?    @map("print_pdf_pages")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shopId])
  @@map("order_items")
}

/// Per shop per day counter that hands out queue numbers atomically.
model OrderCounter {
  shopId     String @map("shop_id") @db.Uuid
  dateKey    String @map("date_key")
  lastNumber Int    @default(0) @map("last_number")

  @@id([shopId, dateKey])
  @@map("order_counters")
}

/// A print agent installed on a shop's PC. Authenticates with a device token (only its HMAC is stored).
model AgentDevice {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  version    String?
  /// The printers the agent reported last: [{ name, isColor, supportsDuplex, isDefault, offline }].
  printers   Json?
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("agent_devices")
}

/// A 6-digit code the owner types into the agent to link it to the shop. Single use, short lived.
model AgentPairing {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  /// HMAC of the code; unique among every code ever issued so a code cannot be reused later.
  codeHash  String    @unique @map("code_hash")
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([expiresAt])
  @@map("agent_pairings")
}

/// Which physical printer prints each colour mode for a shop.
model ShopPrinter {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  /// black_white | color
  colorMode      String   @map("color_mode")
  printerName    String   @map("printer_name")
  supportsDuplex Boolean  @map("supports_duplex")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, colorMode])
  @@map("shop_printers")
}

enum PrintJobStatus {
  queued
  sent
  printing
  done
  failed
  cancelled
}

/// One document to print on a shop's printer (a page of an order, or a test page).
model PrintJob {
  id          String         @id @default(uuid()) @db.Uuid
  shopId      String         @map("shop_id") @db.Uuid
  /// order | test
  kind        String
  orderId     String?        @map("order_id") @db.Uuid
  orderItemId String?        @map("order_item_id") @db.Uuid
  label       String
  status      PrintJobStatus @default(queued)
  /// Where the PDF lives in storage; the agent downloads it through the API.
  fileKey     String         @map("file_key")
  fileBytes   Int?           @map("file_bytes")
  /// What to print and how: printer, colour, duplex, copies, paper size.
  spec        Json
  deviceId    String?        @map("device_id") @db.Uuid
  attempts    Int            @default(0)
  error       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  sentAt      DateTime?      @map("sent_at")
  finishedAt  DateTime?      @map("finished_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([orderId])
  @@map("print_jobs")
}
