    "@prisma/client": "^7.10.0",
    "@socket.io/postgres-adapter": "^0.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
