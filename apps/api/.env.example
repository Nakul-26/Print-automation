NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://print:print@localhost:5432/print?schema=public
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
STORAGE_ROOT=./data
# 5 GB default; can be changed later from the admin panel without redeploying
STORAGE_MAX_BYTES=5368709120
RETENTION_HOURS=24
MAX_UPLOAD_BYTES=20971520
# Ghostscript. Local dev with Docker (docker compose up tools): 
#   GS_COMMAND=docker exec -i print-tools gs
# Production/Linux with ghostscript installed: gs
GS_COMMAND=docker exec -i print-tools gs
GS_TIMEOUT_MS=60000
MAX_PDF_PAGES=500
UPLOAD_RATE_LIMIT_MAX=30
WORKER_CONCURRENCY=2
# LibreOffice converter (infra/office/convert.py). Local dev with Docker:
#   OFFICE_COMMAND=docker exec -i print-tools python3 /opt/print-convert/convert.py
OFFICE_COMMAND=docker exec -i print-tools python3 /opt/print-convert/convert.py
OFFICE_TIMEOUT_MS=120000
CONVERT_RATE_LIMIT_MAX=60
