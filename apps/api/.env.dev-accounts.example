# Dummy accounts for LOCAL testing only. This file is git-ignored; never use these on a real server.
# Create them with:  pnpm --filter @print/api cli seed-dev-accounts
# (it refuses to run unless the database is on localhost).
#
# Copy to .env.dev-accounts and replace every CHANGE-ME with your own password (10+ characters).

# platform admin  -> /admin
DEV_ADMIN_EMAIL=admin@dev.test
DEV_ADMIN_PASSWORD=CHANGE-ME-xxxx

# shop owner of "Dev Prints"  -> /owner
DEV_OWNER_EMAIL=owner@dev.test
DEV_OWNER_PASSWORD=CHANGE-ME-xxxx

# staff of "Dev Prints"  -> /owner (limited: no prices, printers or staff)
DEV_STAFF_EMAIL=staff@dev.test
DEV_STAFF_PASSWORD=CHANGE-ME-xxxx

# owner of "Dev Pending Shop" (waiting for approval)  -> /owner
DEV_PENDING_OWNER_EMAIL=pending@dev.test
DEV_PENDING_OWNER_PASSWORD=CHANGE-ME-xxxx
