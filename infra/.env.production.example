# Environment for infra/compose.prod.yaml. In Dokploy, enter these in the application's
# Environment tab. Never commit real values. Step by step: docs/deployment.md.
#
# Use letters and digits only (hex) for passwords: they go into a connection URL.
# Generate each with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# --- required ---
# Postgres superuser password (used by the database itself and by the backup checks only).
POSTGRES_PASSWORD=change-me
# Password of the `print_app` database role the application uses.
APP_DB_PASSWORD=change-me-too
# Public address users open (HTTPS, no trailing slash). Must match the domain in Cloudflare/Dokploy.
APP_ORIGIN=https://print.fiveorbit.tech
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-64-random-hex-characters-change-me-to-64-random-hex

# --- backups (required: the stack will not start without them) ---
# Public key of the backup key pair (starts with age1...). Create the pair as described in
# docs/runbook.md and keep the PRIVATE key off this server.
BACKUP_AGE_PUBLIC_KEY=age1...
# "r2:" is the Cloudflare R2 connection below; after the colon: bucket name and a folder.
BACKUP_REMOTE=r2:fiveorbit-print-backups/prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: a healthchecks.io (or similar) ping URL. You get an alert if no backup succeeds.
# BACKUP_PING_URL=
# BACKUP_AT=02:30
# BACKUP_KEEP_DAYS=30

# --- recommended ---
# Cloudflare Turnstile (stops bots placing orders and applying for shops). Free; create a widget.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Shown on the owner dashboard as "install the printing app" buttons (leave out to hide).
# VITE_AGENT_STORE_URL=
# VITE_AGENT_DOWNLOAD_URL=

# --- optional ---
# LOG_LEVEL=info
# STORAGE_MAX_BYTES=5368709120      # default; change it live in the admin panel afterwards
# RETENTION_HOURS=24
# MAX_UPLOAD_BYTES=20971520
# API_MEMORY_LIMIT=1g
#
# Document processing runs in the separate `worker` service. Leave the concurrency settings
# unset to size them from the container's CPU and memory. To add capacity, raise
# WORKER_REPLICAS, but never beyond the server's spare CPU cores: extra workers on a full
# server slow every job down. Measure first (docs/load-testing.md, docs/adr/0009).
# WORKER_REPLICAS=1
# WORKER_MEMORY_LIMIT=3g
# WORKER_CONCURRENCY=      # jobs at once per worker (default: min(cores-1, memory/JOB_MEMORY_MB))
# OFFICE_CONCURRENCY=      # of those, LibreOffice conversions (default: about half)
# JOB_MEMORY_MB=600
# PREVIEW_CONCURRENCY=     # print previews built at once in the API (default: cores-1)
# PREVIEW_MAX_WAITING=30   # more than this waiting -> "busy, retrying" instead of a slow queue
