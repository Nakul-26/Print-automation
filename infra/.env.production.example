# Environment for infra/compose.prod.yaml. In Dokploy, enter these in the application's
# Environment tab. Never commit real values.

POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Public address users open (HTTPS). Must match the domain configured in Dokploy.
APP_ORIGIN=https://print.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-64-random-hex-characters-change-me-to-64-random-hex

# Optional
# POSTGRES_USER=print
# POSTGRES_DB=print
# LOG_LEVEL=info
# STORAGE_MAX_BYTES=5368709120
# RETENTION_HOURS=24
# MAX_UPLOAD_BYTES=20971520
# WORKER_CONCURRENCY=2
# API_MEMORY_LIMIT=2g
