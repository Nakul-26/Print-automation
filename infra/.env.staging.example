# Staging: a second Dokploy Compose application from the same repository and compose file, with
# its own domain and its own data. Use it to try a change before it reaches the shop.
# Differences from production are marked.

POSTGRES_PASSWORD=change-me-different-from-production
APP_DB_PASSWORD=change-me-too-different-from-production
APP_ORIGIN=https://print-staging.fiveorbit.tech
SESSION_SECRET=a-different-64-hex-secret-from-production

# Backups: a separate folder so a staging backup can never be mistaken for a production one.
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_REMOTE=r2:fiveorbit-print-backups/staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
BACKUP_KEEP_DAYS=7

# Smaller limits: staging shares the PC with production.
API_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=2g
WORKER_REPLICAS=1
STORAGE_MAX_BYTES=1073741824

# Cloudflare's published always-pass test keys: no real CAPTCHA, so staging can be scripted.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
